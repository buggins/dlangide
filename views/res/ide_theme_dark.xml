<?xml version="1.0" encoding="utf-8"?>
<theme id="ide_theme_dark" parent="theme_dark"
        fontFace="Segoe UI,Helvetica Neue,Verdana,Arial,DejaVu Sans,Liberation Sans,Helvetica,Roboto,Droid Sans"
        fontFamily="SansSerif"
	textColor="#E0E0E0"
	>
    <color id="edit_background" value="#070808"/>
    <color id="link_color" value="#2020FF"/>
    <color id="syntax_highlight_comment" value="#10C010"/>
    <color id="syntax_highlight_keyword" value="#4080FF"/>
    <color id="syntax_highlight_string" value="#C37525"/>
    <color id="syntax_highlight_character" value="#C37525"/>
    <color id="syntax_highlight_error" value="#FF0000"/>
    <color id="syntax_highlight_comment_documentation" value="#50a000"/>
    <color id="syntax_highlight_integer" value="#FFFFFF"/>
    <color id="syntax_highlight_float" value="#FFFFFF"/>
    <color id="syntax_highlight_ident" value="#C0C0C0"/>

    <color id="build_log_filename_color" value="#3030FF"/>
    <color id="build_log_error_color" value="#FF4040"/>
    <color id="build_log_warning_color" value="#E0E000"/>
    <color id="build_log_deprecation_color" value="#F05080"/>

    <drawable id="btn_check" value="btn_check_dark"/>
    <drawable id="link-with-editor" value="link-with-editor_dark"/>
    <!-- SVG icons in views/res/icons (#526) -->
    <drawable id="debug-start" value="debug-start_dark"/>
    <drawable id="debug-continue" value="debug-continue_dark"/>
    <drawable id="run-project" value="run-project_dark"/>
    <drawable id="debug-pause" value="debug-pause_dark"/>
    <drawable id="debug-stop" value="debug-stop_dark"/>
    <drawable id="debug-restart" value="debug-restart_dark"/>
    <drawable id="debug-step-into" value="debug-step-into_dark"/>
    <drawable id="debug-step-over" value="debug-step-over_dark"/>
    <drawable id="debug-step-out" value="debug-step-out_dark"/>
    <drawable id="run-build" value="run-build_dark"/>
    <drawable id="run-build-clean" value="run-build-clean_dark"/>
    <drawable id="run-rdmd" value="run-rdmd_dark"/>

    <!-- as in ide_theme_default: this theme is based on dlangui's theme_dark, not on ide_theme_default -->
    <style id="TERMINAL" parent="EDIT_BOX_NO_FRAME"
    />

    <style id="HOME_SCREEN_TITLE"
        fontSize="160%"
        textColor="#60A0FF"
    />
  
    <style id="HOME_SCREEN_TITLE2"
        fontSize="120%"
        textColor="#60A0FF"
    />

    <style id="HOME_SCREEN_COPYRIGHT"
        textColor="#60A0FF"
    />

</theme>
